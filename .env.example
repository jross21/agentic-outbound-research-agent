# ─────────────────────────────────────────────────────────────────────────────
# Outbound Research Agent — environment
#
# The app runs FULLY KEYLESS: with no keys set, every external tool falls back to
# deterministic sample fixtures (data/sample/) and the sequencer defaults to
# dry-run. Add keys only to exercise the live integration paths.
# ─────────────────────────────────────────────────────────────────────────────

# Required ONLY for live LLM calls. Without it, the agent loop cannot run a real
# model — keyless demos use the sample tools but still need a model to reason;
# see README for the offline "scripted run" demo that needs no key.
ANTHROPIC_API_KEY=

# Force every tool + the sequencer into sample/dry-run mode regardless of which
# other keys are present. Set to 1 for deterministic demos and CI.
FORCE_SAMPLE=

# ── Live research providers (optional) ───────────────────────────────────────
# Web search for the live web.search tool (Serper or Exa — pick one).
SEARCH_API_KEY=
# Company + people enrichment for the live enrichment / findContacts tools.
ENRICHMENT_API_KEY=

# ── CRM read (optional) ──────────────────────────────────────────────────────
# Enables the live crm.read tool (prior-touch context) and the HubSpot sequencer.
HUBSPOT_ACCESS_TOKEN=

# ── Activation / sequencer (optional) ────────────────────────────────────────
# Which sequencer to enroll into on approval: dryrun (default) | hubspot | apollo
SEQUENCER=dryrun
# Apollo sequence enrollment (only if SEQUENCER=apollo).
APOLLO_API_KEY=
